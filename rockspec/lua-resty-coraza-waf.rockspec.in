package = "lua-resty-coraza-waf"
version = "@VERSION@-1"
source = {
   url = "https://github.com/@REPO@/releases/download/v@VERSION@/lua-resty-coraza-waf-@VERSION@.tar.gz",
   md5 = "@MD5@",
   dir = "lua-resty-coraza-waf-@VERSION@",
}

description = {
   summary = "Coraza WAF with the OWASP CRS for OpenResty, through LuaJIT FFI",
   detailed = [[
The release ships coraza_waf.so prebuilt for Linux x86_64 and aarch64
(glibc 2.28 or later), so installing needs neither Go nor libre2.
]],
   homepage = "https://github.com/@REPO@",
   license = "Apache License 2.0",
}

supported_platforms = { "linux" }

dependencies = {}

build = {
   type = "make",
   build_variables = {},
   install_variables = {
      LIBDIR = "$(LIBDIR)",
      LUADIR = "$(LUADIR)",
   },
}
